# rename files in text editor
rename() {
  if [ "$#" -ne 1 ]; then
    echo "error: only one file can be renamed" | _dmenuerr
    exit 1
  fi
  curname="$(basename "$@")"
  msg="press Esc or Enter to exit"
  newname=$(echo "$msg" | _dmenu -p "Rename '${curname}' to:")
  # empty or Esc/Enter
  if [ -z "$newname" ] || [ "$newname" = "$msg" ]; then
    return
  fi
	if [ "$curname" = "$newname" ]; then
    echo "error: current file '${curname}' and the new file '${newname}' have the same name" | _dmenuerr
    exit 1
  fi
	if [ -e "$newname" ]; then
    echo "error: file or directory '${newname}' alredy exists" | _dmenuerr
    exit 1
  fi
  mv -v -- "$curname" "$newname"
}

