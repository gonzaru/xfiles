# set mime type (see ~/.config/mimeapps.list, ~/.local/share/applications/mime* etc)
setmime() {
  # xdg-mime and file returns differnts mime types
  kind="$1"
  shift
  if [ "$kind" = "file" ]; then
    curmime=$(file --brief --mime-type "$*")
  elif [ "$kind" = "mimetype" ]; then
    curmime=$(mimetype --brief "$*")
  else
    curmime=$(xdg-mime query filetype "$*")
  fi
  if [ -z "$curmime" ]; then
    echo "error: filetype '${*}' does not have a valid mime" | _dmenuerr
    exit 1
  fi
  defprgmime=$(xdg-mime query default "$curmime")
  msg="press Esc or Enter to exit"
  newprg=$(echo "$msg" | _dmenu -p "Set default mime type '${curmime}' {${defprgmime}} to program:")
  # empty or Esc/Enter
  if [ -z "$newprg" ] || [ "$newprg" = "$msg" ]; then
    return
  fi
  mimepaths="/usr/share/applications /usr/local/share/applications ${HOME}/.local/share/applications"
	# shellcheck disable=SC2086
  if ! find $mimepaths -name '*.desktop' -print 2>/dev/null | grep -qE "/?${newprg}.desktop$"; then
    echo "error: mime type file '${newprg}.desktop' does not exist" | _dmenuerr
    exit 1
  fi
  xdg-mime default "${newprg}.desktop" "$curmime" &
}

# open text editor on given file
edit() {
  #xterm -into "$WINDOWID" -bw 0 -e "$EDITOR" -- "$@"
  if [ "$#" -ne 1 ]; then
    echo "error: only one file can be edited" | _dmenuerr
    exit 1
  fi
