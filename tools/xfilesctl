# create a directory named on text editor
makedir() {
  msg="press Esc or Enter to exit"
  newdir=$(echo "$msg" | _dmenu -p "New directory:")
  # empty or Esc/Enter
  if [ -z "$newdir" ] || [ "$newdir" = "$msg" ]; then
    return
  fi
	if [ -e "$newdir" ]; then
    echo "error: file or directory '${newdir}' alredy exists" | _dmenuerr
    exit 1
  fi
  mkdir -v -p "$newdir"
}

# create a file named on text editor
makefile() {
  if [ "$#" -eq 0 ]; then
    echo "error: missing argument" | _dmenuerr
    exit 1
  elif [ "$#" -ne 1 ]; then
    echo "error: only one file can be created" | _dmenuerr
    exit 1
  fi
	cmd="$1"
	shift 1
  msg="press Esc or Enter to exit"
  newfile=$(echo "$msg" | _dmenu -p "New file ($cmd):")
  # empty or Esc/Enter
  if [ -z "$newfile" ] || [ "$newfile" = "$msg" ]; then
    return
  fi
	if [ -e "$newfile" ]; then
    echo "error: file or directory '${newfile}' alredy exists" | _dmenuerr
    exit 1
  fi
	if [ "$cmd" = "empty" ]; then
	  touch "$newfile"
	elif [ "$cmd" = "edit" ]; then
    edit "$newfile"
	fi
}

