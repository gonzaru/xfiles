}

# open dialog asking for confirmation ("$1" is the prompt, rest are filenames)
dialog() {
	"$ask" || return 0
	prompt="$1"
	shift 1
	#{
	#	printf "%s\n" "$prompt"
	#	printf "\t%s\n" "$@"
	#} | xmessage -buttons Yes:0,No:1 -nearmouse -file -
  if [ "$(printf 'no\nyes' | _dmenu -p "$prompt ${*}")" = "yes" ]; then
    return 0
  fi
  return 1
}

# if $1 == /path/to/file_1.txt exists, set $uniquepath to /path/to/file_2.txt and so on
setuniquepath() {
	basename="${1##*/}"
	dirname="${1%/*}"
	body="${basename%.*}"
	ext="${basename##"$body"}"

	# create unique name
	unset -v i p
	while test -e "$dirname/$body$p$i$ext"; do
		p="_"
		if [ -z "$i" ]; then
			i=1
		else
			i=$((i + 1))
		fi
	done
	uniquepath="$dirname/$body$p$i$ext"
}

# copy files here if user confirms dialog
copy() {
	dialog "Copy files to $PWD?" "$@" && {
		for file; do
			setuniquepath "$PWD/${file##*/}"
			cp -v "$file" "$uniquepath"
		done
	}
}

# move files here if user confirms dialog
move() {
	dialog "Move files to $PWD?" "$@" && {
		for file; do
			setuniquepath "$PWD/${file##*/}"
			mv -v "$file" "$uniquepath"
		done
	}
}

# link files here if user confirms dialog
link() {
	dialog "Link files to $PWD?" "$@" && {
		for file; do
			setuniquepath "$PWD/${file##*/}"
			ln -s "$file" "$uniquepath"
		done
	}
}

# send files to trash if user confirms dialog
trash() {
	case $# in (0) return ;; esac
	dialog "Send files to trash?" "$@" || return
	# shellcheck disable=SC2174
	mkdir -m 700 -p -- "$TRASH/files" "$TRASH/info" || exit 1
	for file; do
		test -e "$file" || continue

		# get unique target
		setuniquepath "$TRASH/files/${file##*/}"

		# move file to trash and write trash information
		mv -- "$file" "$uniquepath" && \
		cat > "$TRASH/info/${uniquepath##*/}.trashinfo" <<-END
			[Trash Info]
			Path=$file
			DeletionDate=$(date +"%FT%H:%M:%S")
		END
	done
}

# find files on the selected directory
findfiles() {
  if [ "$#" -gt 1 ]; then
    echo "error: only one directory is allowed" | _dmenuerr
    exit 1
  elif [ "$#" -eq 1 ]; then
	  dirname="${1%/}"
	else
	  dirname="${PWD}"
  fi
  if [ ! -d "$dirname" ]; then
    echo "error: only directories can use find" | _dmenuerr
    exit 1
  fi
	if [ -z "$(ls -A "$dirname")" ]; then
    echo "error: the directory '$dirname' is empty" | _dmenuerr
    exit 1
	fi
	# entry=$(find "$dirname" -type f | dmenu -l 10)
	hidden=$([ -n "$XFILES_SHOW_HIDDEN" ] && [ "$XFILES_SHOW_HIDDEN" = 1 ] && echo "--hidden" || echo "")
	entry="${dirname}"/$(fd --base-directory "$dirname" "$hidden" | _dmenusel -p "$(basename "${dirname}")/" -l 25)
	entry="${entry%/}"
	if [ "$entry" = "$dirname" ]; then
	  return
	fi
	if [ -d "$entry" ]; then
		changedir "$entry"
	else
		open "$entry"
	fi
}

# restore files from trash if user confirms dialog
untrash() {
	case $# in (0) return ;; esac

	# compose dialog message
	msg="Restore files from trash?"
	for file; do
		shift
		basename="${file##*/}"
		infofile="$TRASH/info/$basename.trashinfo"
		origfile="$(sed -En '/^[[:blank:]]*Path[[:blank:]]*=/{s/.*=[[:blank:]]*//;p;q;}' < "$infofile")"
		if test -e "$origfile"; then
			warn "$basename: file already exists on original directory"
		else
			set -- "$file" "$origfile" "$infofile"
			msg="$msg
	$origfile"
		fi
	done

	dialog "$msg" || return

	while test $# -gt 0; do
		file="$1"
		origfile="$2"
		infofile="$3"
		shift 3
		mv -- "$file" "$origfile" && rm -- "$infofile"
	done
}

# rm file if user confirms dialog (if at trash, also remove info file)
delete() {
	dialog "Delete files permanently?" "$@" || return
	rm -rf -- "$@"
	case "$PWD" in
	("$TRASH/files")
		for file; do
			rm -rf -- "$TRASH/info/${file##*/}.trashinfo"
		done
		;;
	esac
}

# delete all files in trash can (directory)
emptytrash() {
	dialog "Empty trash?" || return
	rm -rf "$TRASH/files/"*
	rm -rf "$TRASH/info/"*
}

# save file paths into clipboard
snarf() {
	case "$#" in
	(0)
		# no file to copy
		return
		;;
	esac
	# send URIs to clipboard
	# printf 'file://%s\r\n' "$@" |\
	# xclip -selection clipboard -in -target "text/uri-list" &
	# modified as is not pasted always if text/uri-list does not exist
	printf 'file://%s\n' "$@" |\
	xclip -selection clipboard &
}

# paste file whose paths are on clipboard
paste() {
	cmd="$1"
	shift 1
	{
		# get URIs from clipboard
		xclip -selection clipboard -out -target "text/uri-list"
		echo
	} | sed 's,^file://,,' | tr -d '\r' | {
		set --
		while read -r f; do
			case "$f" in
			("")
				;;
			(*)
				set -- "$@" "$f"
				;;
			esac
		done
		case "$cmd" in
		("cp")
			copy "$@"
			;;
		("mv")
			move "$@"
			;;
		("ln")
			link "$@"
			;;
		esac
	}
}

