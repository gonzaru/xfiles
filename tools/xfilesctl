    # open {$(xdg-mime query default "$(xdg-mime query filetype "$*")" | sed 's/\.desktop$//')}
		# open {$(xdg-mime query default "$(mimetype --brief "$*")" | sed 's/\.desktop$//')}
    # open {$(xdg-mime query default "$(file --brief --mime-type "$*")" | sed 's/\.desktop$//')}
    # TODO: file and mimetype returns sometimes a different mime than xdg-mime
		cat <<-EOF
		open {$(xdg-mime query default "$(xdg-mime query filetype "$*")" | sed 's/\.desktop$//')}
		open (with)
		find ($(basename "$1"))
		set mime (xdg)
		set mime (mimetype)
		set mime (file)
		check mime
		rename
		snarf
		trash
		delete (dialog)
		EOF
		;;
	esac | menu | {
		read -r option
		case "$option" in
		("rename")
			rename "$@"
			;;
		("set mime (xdg)")
			setmime "xdg" "$1"
			;;
		("set mime (file)")
			setmime "file" "$1"
			;;
		("set mime (mimetype)")
			setmime "mimetype" "$1"
			;;
		("check mime")
			checkmime "$1"
			;;
		("snarf")
			snarf "$@"
			;;
		("delete")
			delete "$@"
			;;
		("delete (dialog)")
		  tmpask=$ask
		  ask=true
			delete "$@"
			ask=$tmpask
			;;
		("trash")
			trash "$@"
			;;
		("untrash")
			untrash "$@"
			;;
		#("open")
		("open {"*)
      if [ "$#" -ne 1 ]; then
        echo "error: only one file can be opened" | _dmenuerr
        exit 1
      fi
			open "$1"
			;;
		("open (with)")
      if [ "$#" -ne 1 ]; then
        echo "error: only one file can be opened" | _dmenuerr
        exit 1
      fi
			openwith "$1"
			;;
		("find ($(basename "$1"))")
		  findfiles "$@"
		  ;;
		esac
	}
}

# keys in the code widget.c
#    1. Navigation (Moving the Highlight)
#     These keys move the "focused" item (the one with the border/highlight).
#
#    * Up / k: Move highlight up one row.
#    * Down / j: Move highlight down one row.
#    * Left / h: Move highlight to the item on the left.
#    * Right / l: Move highlight to the item on the right.
#    * Home: Jump to the very first item (usually ..).
#    * End: Jump to the very last item in the folder.
#    * Prior (Page Up): Scroll up half a page and move highlight.
#    * Next (Page Down): Scroll down half a page and move highlight.
#
#   2. Selection (Marking Files)
#   These keys determine which files are "selected" for an operation.
#
#    * Space: Toggle selection of the current item and move highlight to the next one.
#    * Shift + Navigation: Select a range of items (e.g., Shift + Down selects multiple files).
#    * Control + Navigation: Select individual items without unselecting others.
#    * Escape: Clear all selections (unselect everything).
#
#   3. Execution (Opening/Menus)
#   These keys trigger the main interactions.
#
#    * Return (Enter): Open the highlighted item (enters a folder or runs xfilesctl open).
#    * Menu key: Open the context menu (runs xfilesctl menu).
#
#   4. Special "Passed" Keys (Sent to xfilesctl)
#   These keys do nothing inside the C code; instead, they are immediately sent to your xfilesctl script as strings (with a ^ prefix).
#
#    * Function Keys: F1 through F13 (sent as ^F1, ^F2, etc.).
#    * Editing Keys: Delete, BackSpace, Tab.
#    * Control + Any ASCII Key: Any combination like Ctrl+R, Ctrl+L, Ctrl+C, etc. (sent as ^r, ^l, ^c).

operation="$1"
# echo "$operation" > /tmp/key.txt
shift 1
for file
do
	shift 1
	case "$file" in
	("")
		# ignore empty arguments
		continue
		;;
	([!/]*)
		file="$PWD/$file"
		;;
	esac
	set -- "$@" "$file"
done
case "$operation" in
("menu"|^m)  # just 'm'
	case "$#" in
	(0)
		# right click on empty area; create a menu
		dirmenu "$@"
		;;
	(*)
		# right click on files; create a menu
		filemenu "$@"
		;;
	esac
	;;
("drop-ask")
	# droped something; create a menu
	dropmenu "$@"
	;;
("drop-copy")
	# copy dropped files here
	copy "$@"
	;;
("drop-move")
	# move dropped files here
	move "$@"
	;;
("drop-link")
	# link dropped files here
	link "$@"
	;;
(^minus|^BackSpace|^b)  # just 'b', just '-', just 'BackSpace' (BackSpace is default like this)
  if [ "$PWD" != "/" ]; then
    echo "$PWD" >> "$LOG_PREVS_DIRS"
    ndirs="$(wc -l < "$LOG_PREVS_DIRS")"
    if [ "$ndirs" -gt "$MAX_PREVS_DIRS" ]; then
      sed -i '1d' "$LOG_PREVS_DIRS"
    fi
  fi
	# go up
	changedir ".."
	;;
(^equal|^S-asciitilde|^d)  # just 'd'
  # go home
	changedir "$HOME"
	;;
# ADDED: (previous dir)
# TODO: why OLDPWD is not set?
# changedir "-" does not work
(^6)
 if [ -f "${LOG_PREV_DIR}" ]; then
   pwd >> "$LOG_PREVS_DIRS"
   ndirs="$(wc -l < "$LOG_PREVS_DIRS")"
   if [ "$ndirs" -gt "$MAX_PREVS_DIRS" ]; then
     sed -i '1d' "$LOG_PREVS_DIRS"
   fi
   changedir "$(cat "${LOG_PREV_DIR}")"
 fi
;;
(^f)  # just 'f'
  if [ -s "$LOG_PREVS_DIRS" ]; then
    last=$(tail -n 1 "$LOG_PREVS_DIRS")
    if [ -d "$last" ]; then
      changedir "$last"
      # remove last line
      sed -i '$d' "$LOG_PREVS_DIRS"
    fi
  fi
;;
(^F)
  findfiles "$@"
;;
# TODO: without xdotool?
(^p)  # just 'p'
  # scroll up
  xdotool click 4 &
	;;
# TODO: without xdotool?
(^n)  # just 'n'
  # scroll down
  xdotool click 5 &
	;;
(^F2|^R)
	# rename files on text editor
	rename "$@"
	;;
(^F5|^r)  # just 'r'
	# cd to where we are just to refresh
	changedir "."
	;;
(^w)  # just 'w'
  groot="$(git rev-parse --show-toplevel)"
  if [ -d "$groot" ]; then
    changedir "$groot"
  fi
  ;;
(^W)  # just 'W'
  # change to custom directory
  if [ -f "${LOG_CUSTOM_DIR}" ]; then
    changedir "$(cat "${LOG_CUSTOM_DIR}")"
  fi
  ;;
(^s)  # just 's'
  # set to custom directory
  pwd > "${LOG_CUSTOM_DIR}"
  ;;
(^slash)  # just '/'
	# open URL bar to go somewhere or open something
	urlbar
	;;
(^[Cc])
	# snarf files
	snarf "$@"
	;;
(^[Pp])
	# move snarfed files
	paste "mv"
	;;
(^[Vv])
	# copy snarfed files
	paste "cp"
	;;
(^Delete|^D)  # just 'Delete' (it's default like this)
	case "$PWD" in
	("$TRASH/files")
		# delete files from trash
		delete "$@"
		;;
	(*)
		# send files to trash
		trash "$@"
		;;
	esac
	;;
esac
