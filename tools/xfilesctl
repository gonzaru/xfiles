        -sf '#FFFFFF' -sb '#FF0000' \
        -fn 'DejaVu Sans Mono:pixelsize=14:antialias=true:autohint=true'
}

# print error message
warn() {
	printf '%s: %s\n' "${0##*/}" "$*" >&2
}

# print error message and exit
err() {
	warn "$@"
	exit 1
}

