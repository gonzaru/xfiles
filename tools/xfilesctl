# open new xfiles window on current directory
newwin() {
	xfiles &
}

# open terminal window running given command
term() {
	xterm &
}

# checks if the program needs a terminal emulator
withterm() {
  program="$1"
  nongui="gorum less lynx man more mpv mplayer nvi vi vim"
  for prg in $nongui; do
    if [ "$prg" = "$program" ]; then
      return 1
    fi
  done
  return 0
}

# open given files (on background, so xfiles not wait)
open() {
	command -- "$OPENER" "$@" &
}

# open given files with a custom program (on background, so xfiles not wait)
openwith() {
  args="$*"
  msg="press Esc or Enter to exit"
  prgfull=$(echo "$msg" | _dmenu -p "Open file '${args}' with:")
  # empty or Esc/Enter
  if [ -z "$prgfull" ] || [ "$prgfull" = "$msg" ]; then
    return
  fi
  prgbase=$(echo "$prgfull" | cut -d ' ' -f1)
  if ! command -v "$prgbase" >/dev/null 2>&1; then
    echo "error: program '${prgbase}' is missing" | _dmenuerr
    exit 1
  fi
  if ! withterm "$prgbase"; then
	  command -- xterm -e "$prgfull '${args}'" &
  else
	  eval command -- "$prgfull" "'${args}'" &
	fi
}

