# change current directory of XFiles window
changedir() {
  # ADDED
  oldpwd="${LOG_PREV_DIR}"
  if [ -e "$oldpwd" ] && [ "$PWD" != "$(cat "$oldpwd")" ] && [ "$PWD" != "/" ] || [ ! -e "$oldpwd" ]; then
    echo "$PWD" > "$oldpwd"
  fi
	xprop -id "$WINDOWID" -format "_CONTROL_GOTO" 8u -set "_CONTROL_GOTO" "$1"
}

# prompt for file to open or directory to go to
urlbar() {
	# printf '%s\n' * | prompt | {
	if [ -n "$XFILES_SHOW_HIDDEN" ] && [ "$XFILES_SHOW_HIDDEN" = 1 ]; then
    files="$({
      fd --max-depth 1 --type d;
      fd '^\.' --max-depth 1 --type d --hidden;
      fd --max-depth 1 --type l;
      fd '^\.' --max-depth 1 --type l --hidden;
      fd --max-depth 1 --type f "$hidden";
      fd '^\.' --max-depth 1 --type f --hidden;
    })"
  else
    files="$({
      fd --max-depth 1 --type d;
      fd --max-depth 1 --type l;
      fd --max-depth 1 --type f;
    })"
  fi
	echo "$files" | prompt | {
		read -r entry
	  if [ -z "$entry" ]; then
	    return
	  fi
		if [ -d "$entry" ]; then
			changedir "$entry"
		else
			open "$entry"
		fi
	}
}

# pop-up menu for file dropping
dropmenu() {
	{
		cat <<-EOF
		copy
		move
		link
		none
		EOF
	} | menu | {
		read -r option
		case "$option" in
		("copy")
			copy "$@"
			;;
		("move")
			move "$@"
			;;
		("link")
			link "$@"
			;;
		("term")
			term
			;;
		esac
	}
}

